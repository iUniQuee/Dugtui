# ---- Web Push (VAPID) — зөвхөн серверт уншигдана, VITE_ угтвар ХЭРЭГГҮЙ ----
# Түлхүүр үүсгэх: `node scripts/generate-vapid-keys.mjs`
# Cloudflare Pages дээр: Settings → Environment variables → Secrets
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- /api/push/notify нь Supabase access token-ыг шалгаж, админы
#      push subscription-уудыг уншихад эдгээрийг ашиглана (серверт)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# API server-ийн порт (локал)
API_PORT=8787
