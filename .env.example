# ---- Bogd QPay Merchant V2 (зөвхөн сервер талд уншигдана, VITE_ угтвар ХЭРЭГГҮЙ) ----
# Production: https://merchant.qpay.mn
# Sandbox:    https://merchant-sandbox.qpay.mn
QPAY_BASE_URL=https://merchant.qpay.mn

# Bogd QPay merchant dashboard-аас авсан мэдээлэл
# (ажиллаж буй Cloudflare Pages дээр эдгээрийг Settings → Environment variables → Secrets
#  гэж нэмнэ; .env файл зөвхөн локал `npm run api`-д хэрэглэгдэнэ)
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# QPay төлбөр баталгаажсаны дараа дуудах хаяг (production дээр нийтэд нээлттэй байх ёстой)
# Cloudflare Pages дээр: https://dugtui.pages.dev/api/qpay/callback
QPAY_CALLBACK_URL=http://localhost:8787/api/qpay/callback

# ---- Callback/check үед өрөөг PAID болгож бичихэд (сонголттой, зөвхөн серверт) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API server-ийн порт (локал)
API_PORT=8787
